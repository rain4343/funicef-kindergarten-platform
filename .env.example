# ================================
# Local development configuration
# ================================
# PostgreSQL connection used by NestJS and Drizzle.
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_admin123@localhost:5432/unicef_kg

# NestJS API port and public origins.
API_PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# Must be at least 32 random characters in production.
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional academic year used when saving evaluation submissions.
ACADEMIC_YEAR=2026/2027

# Used only by: npm run db:seed
# Current requested test credentials: admin / admin123
SEED_ADMIN_EMAIL=admin@unicef.local
SEED_ADMIN_PASSWORD=admin123

# ================================
# Frontend API routing
# ================================
# Leave this commented for Netlify when using the /backend rewrite in netlify.toml.
# This keeps authentication cookies same-site.
# NEXT_PUBLIC_API_ORIGIN=https://YOUR-RAILWAY-API.up.railway.app

# ================================
# Railway API variables
# ================================
# In Railway, use the PostgreSQL-provided DATABASE_URL.
# Set API_ORIGIN to the Railway API public URL and WEB_ORIGIN to the Netlify URL.
# Example:
# API_ORIGIN=https://your-api.up.railway.app
# WEB_ORIGIN=https://your-site.netlify.app
# NODE_ENV=production
# AUTH_SECRET=generate-a-new-production-secret
